APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
# Share login between shop + creator subdomain (optional; auto-inferred if CREATOR_DOMAIN is a subdomain of APP_URL host)
# SESSION_DOMAIN=.pressonnail.test

# Creator / affiliate portal (subdomain — same account as main shop when SESSION_DOMAIN is shared)
CREATOR_DOMAIN=creator.pressonnail.test
# CREATOR_PORTAL_URL=http://creator.pressonnail.test
# CREATOR_SHOP_URL=http://pressonnail.test

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
# Product import chạy queue riêng — chạy worker: php artisan queue:work database --queue=imports,default
PRODUCT_IMPORT_QUEUE=imports
PRODUCT_IMPORT_MAX_ROWS=2000
PRODUCT_IMPORT_ROW_TIMEOUT=900
PRODUCT_IMPORT_QUEUE_RETRY_AFTER=960

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Email nhận thông báo khi có đơn đăng ký affiliate/KOC (mặc định = MAIL_FROM_ADDRESS nếu để trống)
AFFILIATE_ADMIN_NOTIFICATION_EMAIL=

# Affiliate attribution cookie (last-click ref), minutes — default 14 days = 20160
# AFFILIATE_COOKIE_TTL_MINUTES=20160
# Commission only on customer's first paid order (true/false)
# AFFILIATE_COMMISSION_NEW_CUSTOMERS_ONLY=true

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# Pinterest conversion tag (shop storefront)
PINTEREST_TAG_ID=
PINTEREST_TAG_TEST_MODE=false

# Image API (New API) — https://docs.newapi.pro/en/docs/api/ai-model/images/openai/post-v1-images-generations
OPENAI_API_KEY=
OPENAI_BASE_URL=https://sv.devquote.shop/v1
OPENAI_MODEL=gpt-5.6-luna
OPENAI_TIMEOUT=180

# Virtual nail — chatgpt2api first; fallback /v1/images/edits (New API)
# https://docs.newapi.pro/en/docs/api/ai-model/images/openai/post-v1-images-edits
VIRTUAL_NAIL_ENABLED=false
VIRTUAL_NAIL_PREFER_BROWSER_POOL=true
VIRTUAL_NAIL_IMAGE_MODEL=gpt-image-2
VIRTUAL_NAIL_IMAGE_SIZE=1024x1024
VIRTUAL_NAIL_IMAGE_RESPONSE_FORMAT=b64_json
VIRTUAL_NAIL_IMAGE_TIMEOUT=300
VIRTUAL_NAIL_ASYNC=true
VIRTUAL_NAIL_HISTORY_LIMIT=20
# Optional browser pool
CHATGPT2API_BASE_URL=http://localhost:3000/v1
CHATGPT2API_AUTH_KEY=
CHATGPT2API_IMAGE_MODEL=gpt-image-2
CHATGPT2API_TIMEOUT=180
CHATGPT2API_HEALTH_TIMEOUT=5
VIRTUAL_NAIL_MAX_UPLOAD_KB=8192
VIRTUAL_NAIL_BROWSE_RATE_LIMIT=60
VIRTUAL_NAIL_RATE_LIMIT=10

GOOGLE_SHEETS_SPREADSHEET_ID=
GOOGLE_SHEETS_SHEET_NAME=Sheet1
GOOGLE_SHEETS_CREDENTIALS_PATH=

TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_WEBHOOK_TOKEN=
TELEGRAM_ALLOWED_USER_IDS=
